library(MSnbase)
xeF <- system.file(file.path("extdata", "Urine_HILIC_ESIpos_msLevel1.mzML.zip",
fsep = .Platform$file.sep), package = "lcmsData")
tmp_dir <- tempdir()
mzml <- unzip(xeF, exdir = tmp_dir)
x <- readMSData(mzml, mode = "onDisk")
x_sub <- filterRt(x, c(130, 160))   # seconds, if your file uses seconds
writeMSData(x_sub, file = "inst/extdata/example_rt_200_400.mzML")
writeMSData(x_sub, file = "inst/extdata/HILIC_ESIpos_msLevel1_urine_red.mzML")
runApp('R')
x_sub <- filterRt(x, c(0, 160))   # seconds, if your file uses seconds
writeMSData(x_sub, file = "inst/extdata/HILIC_ESIpos_msLevel1_urine_red.mzML")
writeMSData(x_sub, file = "inst/extdata/HILIC_ESIpos_msLevel1_urine_red1.mzML")
x_sub <- filterRt(x, c(100, 160))   # seconds, if your file uses seconds
writeMSData(x_sub, file = "inst/extdata/HILIC_ESIpos_msLevel1_urine_red1.mzML")
x_sub <- filterRt(x, c(110, 160))   # seconds, if your file uses seconds
writeMSData(x_sub, file = "inst/extdata/HILIC_ESIpos_msLevel1_urine_red.mzML")
